{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "promptzyra",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "PROMPTZYRA_IMAGES",
      "bucket_name": "promptzyra-images"
    }
  ]
}
